rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTracker(data) {
      return data.keys().hasOnly(['targets', 'config']) &&
             data.get('targets', {}) is map &&
             data.get('config', {}) is map;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['id', 'date', 'city', 'packets', 'litres', 'revenue']) &&
             data.keys().hasOnly(['id', 'date', 'city', 'packets', 'litres', 'revenue']) &&
             data.get('id', '') is string &&
             data.get('date', '') is string &&
             data.get('city', '') is string &&
             data.get('packets', 0) is number &&
             data.get('litres', 0) is number &&
             data.get('revenue', 0) is number;
    }

    match /trackers/{trackerId} {
      allow get: if isSignedIn() && isValidId(trackerId);
      allow create: if isSignedIn() && isValidId(trackerId) && isValidTracker(incoming());
      allow update: if isSignedIn() && isValidId(trackerId) && isValidTracker(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['targets', 'config']);
      
      match /logs/{logId} {
        allow read: if isSignedIn() && isValidId(trackerId);
        allow create: if isSignedIn() && isValidId(trackerId) && isValidId(logId) && isValidLog(incoming());
        allow update: if isSignedIn() && isValidId(trackerId) && isValidId(logId) && isValidLog(incoming());
        allow delete: if isSignedIn() && isValidId(trackerId) && isValidId(logId);
      }
    }
  }
}
